"use strict";
var HIDE_DELAY_MS = 2000;
var pushNotification = function(posTop, posRight, title, description, type) {
    var notification = document.createElement("div");
    var titleItem = document.createElement("h2");
    var descriptionItem = document.createElement("p");
    notification.classList.add("notification", type);
    notification.style.top = "".concat(posTop, "px");
    notification.style.right = "".concat(posRight, "px");
    titleItem.textContent = title;
    titleItem.classList.add("title");
    descriptionItem.innerText = description;
    notification.append(titleItem, descriptionItem);
    document.body.append(notification);
    setTimeout(function() {
        notification.style.display = "none";
    }, HIDE_DELAY_MS);
};
pushNotification(10, 10, "Title of Success message", "Message example.\n Notification should contain title and description.", "success");
pushNotification(150, 10, "Title of Error message", "Message example.\n Notification should contain title and description.", "error");
pushNotification(290, 10, "Title of Warning message", "Message example.\n Notification should contain title and description.", "warning");

